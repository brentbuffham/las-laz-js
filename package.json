{
	"name": "las-laz-js",
	"version": "0.19.0",
	"description": "Zero-dependency JavaScript reader and writer for ASPRS LAS point clouds, and reader and writer for LAZ (LASzip), for the browser and Node, built for files larger than memory.",
	"type": "module",
	"exports": {
		".": "./src/index.js",
		"./worker": "./src/workers/lasWorker.js"
	},
	"files": [
		"src",
		"README.md",
		"LICENSE",
		"LICENSE-APACHE",
		"NOTICE",
		"CHANGELOG.md"
	],
	"sideEffects": false,
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"test": "node --test \"test/**/*.test.js\"",
		"test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-lines=97 --test-coverage-branches=88 --test-coverage-functions=97 \"test/**/*.test.js\"",
		"demo": "node _dev/serve.mjs",
		"check:private": "node _dev/checkPrivate.mjs"
	},
	"keywords": [
		"las",
		"laz",
		"lidar",
		"point-cloud",
		"pointcloud",
		"asprs",
		"gis",
		"survey",
		"opfs",
		"threejs"
	],
	"author": "Brent Buffham (https://kirra-design.com)",
	"license": "MIT AND Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/brentbuffham/las-laz-js.git"
	},
	"bugs": {
		"url": "https://github.com/brentbuffham/las-laz-js/issues"
	},
	"homepage": "https://github.com/brentbuffham/las-laz-js#readme"
}
